{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teaguard:research:nature-state:0.1",
  "title": "TeaGuard natural context design contract",
  "description": "Design only; not product code or a physiological/causal model. Semantic rules require a later implementation.",
  "x-design-status": "DESIGN_ONLY_NOT_IMPLEMENTED",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "mode",
    "decision_time_utc",
    "spatial_context",
    "observations",
    "context_factors",
    "evidence_matches",
    "review_tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "HISTORICAL_ANALYSIS",
        "AI_SCENARIO",
        "OPERATIONAL_CANDIDATE"
      ]
    },
    "decision_time_utc": {
      "type": "string",
      "format": "date-time"
    },
    "spatial_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "support_type",
        "latitude",
        "longitude",
        "spatial_claim"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "support_type": {
          "enum": [
            "REGIONAL_GRID",
            "DECLARED_PLOT",
            "AI_SCENARIO"
          ]
        },
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "resolution_m": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "spatial_claim": {
          "enum": [
            "REGIONAL_REFERENCE",
            "SELF_REPORTED_CONTEXT",
            "SCENARIO_ASSUMPTION"
          ]
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "context_factors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/context_factor"
      }
    },
    "evidence_matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "card_id",
          "input_ids",
          "applicability",
          "reason"
        ],
        "properties": {
          "card_id": {
            "type": "string"
          },
          "input_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "applicability": {
            "enum": [
              "MATCH",
              "PARTIAL",
              "MISMATCH",
              "UNKNOWN"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "review_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "task_type",
          "basis_input_ids",
          "evidence_card_ids",
          "status",
          "proposal_basis",
          "next_check",
          "deduplication_key"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "task_type": {
            "enum": [
              "CHECK_DATA_PROVENANCE",
              "CHECK_CONTEXT",
              "REVIEW_HEAT",
              "RECONCILE_CONFLICT",
              "RECHECK_RECORD"
            ]
          },
          "basis_input_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "evidence_card_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "PROPOSED",
              "SIMULATED_COMPLETION",
              "REPORTED_COMPLETION"
            ]
          },
          "proposal_basis": {
            "enum": [
              "ENGINEERING_CHECKLIST",
              "SOURCE_SUPPORTED_CHECK"
            ]
          },
          "next_check": {
            "type": "string",
            "minLength": 1
          },
          "deduplication_key": {
            "type": "string",
            "minLength": 1
          },
          "previous_version_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "value",
        "unit",
        "valid_start_utc",
        "valid_end_utc",
        "available_at_utc",
        "availability_status",
        "availability_evidence",
        "retrieved_at_utc",
        "spatial_support",
        "evidence_origin",
        "source_id",
        "source_sha256",
        "measurement_method",
        "use_scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "GRID_TEMPERATURE",
            "ARCHIVED_FORECAST",
            "REFERENCE_ET0_MINUS_PRECIP",
            "SOIL_DESCRIPTION",
            "PHOTO_NOTE",
            "MANAGEMENT_NOTE",
            "SIMULATED_WEATHER_INDICATOR"
          ]
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_start_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "valid_end_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "available_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "availability_status": {
          "enum": [
            "KNOWN_WITH_EVIDENCE",
            "UNKNOWN",
            "REJECTED"
          ]
        },
        "availability_evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "init_time_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "lead_hours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "spatial_support": {
          "enum": [
            "REGIONAL_GRID",
            "SITE_REPORTED",
            "LEAF_REPORTED",
            "SCENARIO"
          ]
        },
        "evidence_origin": {
          "enum": [
            "PUBLIC_GRID_REANALYSIS",
            "PUBLIC_FORECAST_ARCHIVE",
            "MEASURED_FIELD_WITH_PROVENANCE",
            "HUMAN_SELF_REPORT",
            "AI_AUTHORED_SCENARIO"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "measurement_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "use_scope": {
          "enum": [
            "HISTORICAL_REFERENCE",
            "OPERATIONAL_INPUT_CANDIDATE",
            "SCENARIO_ONLY",
            "WITHHELD"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_origin": {
                "const": "AI_AUTHORED_SCENARIO"
              }
            },
            "required": [
              "evidence_origin"
            ]
          },
          "then": {
            "properties": {
              "use_scope": {
                "const": "SCENARIO_ONLY"
              },
              "spatial_support": {
                "const": "SCENARIO"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "availability_status": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "availability_status"
            ]
          },
          "then": {
            "properties": {
              "available_at_utc": {
                "type": "null"
              },
              "use_scope": {
                "enum": [
                  "HISTORICAL_REFERENCE",
                  "SCENARIO_ONLY",
                  "WITHHELD"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "availability_status": {
                "const": "KNOWN_WITH_EVIDENCE"
              }
            },
            "required": [
              "availability_status"
            ]
          },
          "then": {
            "properties": {
              "available_at_utc": {
                "type": "string",
                "format": "date-time"
              },
              "availability_evidence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "context_factor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "factor",
        "state",
        "input_ids",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "factor": {
          "enum": [
            "SOIL_MOISTURE_DESCRIPTION",
            "SHADE_STATUS",
            "CULTIVAR",
            "GROWTH_STAGE",
            "RECENT_MANAGEMENT"
          ]
        },
        "state": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "UNKNOWN",
            "SELF_REPORTED",
            "MEASURED_WITH_PROVENANCE",
            "AI_SCENARIO"
          ]
        }
      }
    }
  },
  "x-semantic-rules": [
    "Format checking alone does not establish real historical availability.",
    "Known operational input must satisfy init <= available_at <= decision_time and have availability evidence; inherit A0/A1 forecast contract.",
    "Missing value is unknown, never zero or a generated observation.",
    "References resolve to observation IDs or context-factor IDs and registered evidence-card IDs.",
    "AI scenario observations/factors cannot become measured field evidence through aggregation.",
    "An observation with unknown availability cannot support an operational claim.",
    "Regional reanalysis cannot become plot/leaf measurement or an archived forecast.",
    "ET0-P is a reference meteorological balance, not root-zone soil water or irrigation volume.",
    "No shade effect, loss probability, yield benefit or optimal irrigation prescription is represented by this schema.",
    "Context changes do not mutate frozen numeric weather outputs.",
    "Duplicate tasks must preserve evidence lineage and only one active deduplication key."
  ]
}
